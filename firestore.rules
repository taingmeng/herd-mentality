rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Root games collection: anyone can read; only cloud functions can write
    match /games/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    // User game document (stores playCount): user can read; only cloud functions can write
    match /users/{userId}/games/{gameId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Plays subcollection: only matching user can read, create, or update, no delete
    match /users/{userId}/games/{gameId}/plays/{playId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }
  }
}
